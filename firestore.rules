rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolamento estrito por usuário: cada usuário acessa apenas sua própria árvore
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Ciclos Mensais e Subcoleção de Despesas
      match /ciclos_mensais/{mesAno} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /despesas/{despesaId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Tributos e Parcelamentos Anuais
      match /tributos_e_parcelas/{tributoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
